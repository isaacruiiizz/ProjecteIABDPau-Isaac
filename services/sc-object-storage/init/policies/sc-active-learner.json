{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": [
        "arn:aws:s3:::feedback-data/*",
        "arn:aws:s3:::models/*",
        "arn:aws:s3:::datasets/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:DeleteObject"],
      "Resource": [
        "arn:aws:s3:::models/*",
        "arn:aws:s3:::datasets/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::feedback-data",
        "arn:aws:s3:::models",
        "arn:aws:s3:::datasets"
      ]
    }
  ]
}
