{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:DeleteObject"],
      "Resource": [
        "arn:aws:s3:::raw-videos/*",
        "arn:aws:s3:::labeling-videos/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": [
        "arn:aws:s3:::processed-videos/*",
        "arn:aws:s3:::labeling-frames/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::raw-videos",
        "arn:aws:s3:::labeling-videos",
        "arn:aws:s3:::processed-videos",
        "arn:aws:s3:::labeling-frames"
      ]
    }
  ]
}
