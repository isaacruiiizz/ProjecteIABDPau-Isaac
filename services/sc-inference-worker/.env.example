# Internal API Key                           # SECRET
INTERNAL_API_KEY=change_me_internal_key_xxxxx

# Redis
REDIS_HOST=sc-redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_QUEUE_FRAMES=task_frames
REDIS_QUEUE_RESULTS=detected_frames_results
REDIS_QUEUE_MODEL_PROMOTED=model_promoted
REDIS_QUEUE_LABELING=labeling_frames_to_infer

# MinIO
MINIO_ENDPOINT=sc-object-storage:9000
MINIO_ACCESS_KEY=sc-inference-worker
MINIO_SECRET_KEY=change_me_sc_inference_worker_minio_password  # SECRET
MINIO_USE_SSL=false
MINIO_BUCKET_PENDING=pending-frames
MINIO_BUCKET_FEEDBACK=feedback-data
MINIO_BUCKET_MODELS=models
MINIO_BUCKET_LABELING_FRAMES=labeling-frames
MINIO_MODEL_KEY = yolo/base/yolov8n.pt

# IA — producció
YOLO_MODEL_PATH=yolo/weights/v1.pt
CNN_MODEL_PATH=cnn/weights/v1.keras
INFERENCE_CONFIDENCE_THRESHOLD=0.6
PREFETCH_BUFFER_SIZE=8

# IA — pre-anotació etiquetatge
INFERENCE_LABELING_CONFIDENCE=0.3
JERSEY_OWN_COLOR_HSV=            # ex: "120,80,150" — color HSV dominant samarreta pròpia. Si buit, fallback a player_own per tot
JERSEY_COLOR_THRESHOLD=30        # distància màxima HSV per considerar "player_own"

# Label Studio
LABEL_STUDIO_URL=http://sc-label-studio:8081
LABEL_STUDIO_API_TOKEN=          # SECRET - obtenir de LS settings
LABEL_STUDIO_PROJECT_ID=1

# GPU
CUDA_VISIBLE_DEVICES=0

# Sentry
SENTRY_DSN=
