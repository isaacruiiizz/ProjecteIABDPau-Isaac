# ===================================================================
# SmartChrono IP — Variables d'entorn unificades
# Còpia aquest fitxer a .env i ajusta tots els camps marcats # SECRET
# ===================================================================

# ─── MONGODB ──────────────────────────────────────────────────────
MONGO_INITDB_ROOT_USERNAME=smartchrono_user              # SECRET
MONGO_INITDB_ROOT_PASSWORD=change_me_mongo_password      # SECRET

# Primer usuari administrador (creat per sc-mongodb/init/01-init.js)
ADMIN_EMAIL=admin@smartchrono.local                      # SECRET
ADMIN_PASSWORD=change_me_admin_password                  # SECRET
ADMIN_DISPLAY_NAME=Administrador

# URIs de connexió — substituir user/password pels de dalt
MONGO_AUTH_URI=mongodb://smartchrono_user:change_me_mongo_password@sc-mongodb:27017/sc-auth-db?authSource=admin
MONGO_APP_URI=mongodb://smartchrono_user:change_me_mongo_password@sc-mongodb:27017/sc-app-db?authSource=admin

# ─── REDIS ────────────────────────────────────────────────────────
REDIS_HOST=sc-redis
REDIS_PORT=6379
REDIS_PASSWORD=                                          # SECRET — buit en dev, obligatori en prod

# ─── MINIO ────────────────────────────────────────────────────────
MINIO_ROOT_USER=change_me_minio_user                     # SECRET
MINIO_ROOT_PASSWORD=change_me_minio_password             # SECRET
MINIO_ENDPOINT=sc-object-storage:9000
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000                   # URL accessible des del navegador per a signed URLs

# Usuaris IAM per servei (usernames estàtics + passwords)
SC_API_GATEWAY_MINIO_ACCESS_KEY=sc-api-gateway
SC_VIDEO_MANAGER_MINIO_ACCESS_KEY=sc-video-manager
SC_INFERENCE_WORKER_MINIO_ACCESS_KEY=sc-inference-worker
SC_ACTIVE_LEARNER_MINIO_ACCESS_KEY=sc-active-learner
SC_LABEL_STUDIO_MINIO_ACCESS_KEY=sc-label-studio

SC_API_GATEWAY_MINIO_PASSWORD=change_me_sc_api_gateway_password          # SECRET
SC_VIDEO_MANAGER_MINIO_PASSWORD=change_me_sc_video_manager_password      # SECRET
SC_INFERENCE_WORKER_MINIO_PASSWORD=change_me_sc_inference_worker_password # SECRET
SC_ACTIVE_LEARNER_MINIO_PASSWORD=change_me_sc_active_learner_password    # SECRET
SC_LABEL_STUDIO_MINIO_PASSWORD=change_me_sc_label_studio_password        # SECRET

# Label Studio — endpoint MinIO (requereix http://, diferent de la resta de serveis)
LABEL_STUDIO_MINIO_ENDPOINT=http://sc-object-storage:9000
LABEL_STUDIO_MINIO_PRESIGN_ENDPOINT=http://host.docker.internal:9000
AWS_ENDPOINT_URL=http://sc-object-storage:9000

# Buckets (no canviar en producció sense migrar dades)
MINIO_BUCKET_RAW=raw-videos
MINIO_BUCKET_PENDING=pending-frames
MINIO_BUCKET_PROCESSED_FRAMES=processed-frames
MINIO_BUCKET_OUTPUT=processed-videos
MINIO_BUCKET_FEEDBACK=feedback-data
MINIO_BUCKET_MODELS=models
MINIO_BUCKET_LABELING_VIDEOS=labeling-videos
MINIO_BUCKET_LABELING_FRAMES=labeling-frames
MINIO_BUCKET_DATASETS=datasets

# ─── API GATEWAY ──────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false                          # true si HTTPS, false si HTTP

JWT_SECRET=change_me_min_32_chars_xxxxxxxxxxx            # SECRET — mínim 32 caràcters
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

INTERNAL_API_KEY=change_me_internal_key_xxxxx            # SECRET — compartit per tots els workers

# Label Studio (opcional, per a sc-api-gateway)
LABEL_STUDIO_URL=http://sc-label-studio:8081
LABEL_STUDIO_API_TOKEN=                                  # SECRET — obtenir de LS settings un cop arrencat
LABEL_STUDIO_PROJECT_ID=1

# ─── CUES REDIS ───────────────────────────────────────────────────
REDIS_QUEUE_VIDEO=video_to_process
REDIS_QUEUE_FRAMES=task_frames
REDIS_QUEUE_RESULTS=detected_frames_results
REDIS_QUEUE_MODEL_PROMOTED=model_promoted
REDIS_QUEUE_LABELING=labeling_frames_to_infer

# ─── VIDEO MANAGER ────────────────────────────────────────────────
VIDEO_FPS_DEFAULT=25
VIDEO_MAX_RESOLUTION=1920x1080
LABEL_STUDIO_SOURCE_STORAGE_ID=1

# ─── INFERENCE WORKER ─────────────────────────────────────────────
YOLO_MODEL_PATH=yolo/weights/v1.pt
CNN_MODEL_PATH=cnn/weights/v1.keras
MINIO_MODEL_KEY=yolo/base/yolov8n.pt
INFERENCE_CONFIDENCE_THRESHOLD=0.6
PREFETCH_BUFFER_SIZE=8
INFERENCE_LABELING_CONFIDENCE=0.3
JERSEY_OWN_COLOR_HSV=                                    # ex: "120,80,150" — color HSV dominant samarreta pròpia
JERSEY_COLOR_THRESHOLD=30
CUDA_VISIBLE_DEVICES=0

# ─── LOGIC AGGREGATOR ─────────────────────────────────────────────
TRACKING_DISAPPEARANCE_BUFFER_SECONDS=3
TRACKING_MIN_CONFIDENCE=0.6

# ─── ACTIVE LEARNER ───────────────────────────────────────────────
TRAINING_MIN_SAMPLES=50
TRAINING_EPOCHS=10
TRAINING_BATCH_SIZE=16
YOLO_BASE_WEIGHTS=yolo/weights/v1.pt
CNN_BASE_WEIGHTS=cnn/weights/v1.keras

# ─── LABEL STUDIO (servei opcional) ──────────────────────────────
LABEL_STUDIO_PORT=8081
LABEL_STUDIO_USERNAME=admin@smartchrono.local            # SECRET
LABEL_STUDIO_PASSWORD=change_me_ls_password              # SECRET
LABEL_STUDIO_LOCAL_FILES_SERVING_ENABLED=true
LABEL_STUDIO_LOCAL_FILES_DOCUMENT_ROOT=/label-studio/data

# ─── GRAFANA ──────────────────────────────────────────────────────
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change_me_grafana_password    # SECRET
GF_SERVER_HTTP_PORT=3001

# ─── FRONTEND ─────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
VITE_ENV=development
VITE_LABEL_STUDIO_URL=http://localhost:8081

# ─── SENTRY (buit en dev, URL completa en prod) ───────────────────
SENTRY_DSN=
